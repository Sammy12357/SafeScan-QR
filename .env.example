# Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=min-32-char-random-string
JWT_SECRET=min-32-char-random-string
ADMIN_EMAIL=privacy@safescan-qr.onrender.com
ADMIN_EMAILS=homzajoe@gmail.com,restreposamuel2004@gmail.com
OWNER_EMAILS=owner@yourdomain.com
ADMIN_ACCESS_DENYLIST=safescanqr@gmail.com

# Auth0 mobile sign-in
# The Native application signs in with Auth0 Universal Login, then sends its
# Auth0 ID token to POST /auth/verify. AUTH0_DOMAIN must match the token's iss
# tenant (hostname only, without https://). AUTH0_CLIENT_IDS is the comma-
# separated allowlist of Native application client IDs accepted in the aud
# claim. Configure the same domain/client ID in the mobile app and in Render.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_IDS=your-native-app-client-id

# Database
DATABASE_URL=sqlite:////var/data/qr_cache.db
DATA_DIR=/var/data
SQLITE_DB_PATH=/var/data/qr_cache.db

# Deploy safety
AIRDROP_ENABLED=false
SOLANA_MAINNET_ENABLED=false
AIRDROP_DRY_RUN=true
AIRDROP_MAX_RECIPIENTS_PER_RUN=25
AIRDROP_MAX_TOKENS_PER_RUN=2500

# External APIs
VIRUSTOTAL_API_KEY=your-virustotal-key
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key
WHOISXML_API_KEY=
SECURITYTRAILS_API_KEY=
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SQR_TOKEN_MINT_ADDRESS=Bpdt7Hey78HeEEr9Q6x19gYAns5n6w44LdjJhxN3pump
ALPHA_SOLANA_RECIPIENT=your-solana-wallet-address
ALPHA_SOLANA_PRICE_USD=1.00
ALPHA_SOLANA_QUOTE_TTL_SECONDS=600
SOLANA_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd
SOLANA_USD_PRICE_FALLBACK=
ALPHA_SOLANA_AMOUNT_SOL=0.01
ALPHA_SOLANA_ACCESS_DAYS=30
ALPHA_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_6oU8wQ5QRdQf8TC9QEeAg00
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# App
APP_URL=https://safescan-qr.onrender.com
NODE_ENV=production
MOCK_MODE=false
DOMAIN_AGE_CHECK_ENABLED=true
DOMAIN_AGE_CACHE_TTL_DAYS=30
AIRDROP_ADMIN_SECRET=replace-with-random-admin-secret
PRIVACY_HASH_SALT=replace-with-random-privacy-salt

# ML risk model
SAFESCAN_ML_ENABLED=true
SAFESCAN_ML_MODEL_PATH=models/safescan_qr_model.keras
ML_MODEL_OBJECT_KEY=models/safescan_qr_model.keras
SAFESCAN_ML_WEIGHT=0.4
SAFESCAN_ML_MALICIOUS_CLASS_INDEX=1

# Durable storage (Cloudflare R2 or S3-compatible)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
QR_UPLOAD_RETENTION_DAYS=7

# Outbound email (optional - newsletter welcome emails are skipped when unset)
# Works with any SMTP provider: Resend (smtp.resend.com, user "resend",
# password = API key), SendGrid (smtp.sendgrid.net, user "apikey"),
# Brevo, Mailgun, or Gmail with an App Password (smtp.gmail.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=SafeScan QR

# Discord account linking (optional - profile page hides the card when unset)
# Create an app at https://discord.com/developers/applications:
#   OAuth2 -> add redirect <APP_URL>/auth/discord/callback, copy client id/secret.
#   Bot tab -> create bot, copy token, invite it to your server with the
#   Manage Roles permission (its role must sit ABOVE the Verified role).
# DISCORD_GUILD_ID / DISCORD_VERIFIED_ROLE_ID: enable Developer Mode in
# Discord, right-click the server / role -> Copy ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_INVITE_URL=https://discord.gg/hqHBQ22z

# Monitoring
METRICS_ALLOWED_IPS=127.0.0.1,::1,testclient
